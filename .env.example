# Copy to .env.local (dev) or .env (server). Never commit real values.

DATABASE_PATH=./data/lppeptide.db
UPLOAD_DIR=./uploads
SITE_URL=https://lppeptide.com

# openssl rand -base64 48  (at least 32 random bytes)
AUTH_SECRET=

# First admin, used by `npm run db:seed` only. Remove ADMIN_PASSWORD after the first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Client's own mailbox (Nodemailer)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=lppeptideofficial@lppeptide.com
SMTP_PASS=
MAIL_FROM="LPPEPTIDE <lppeptideofficial@lppeptide.com>"
STORE_INBOX=lppeptideofficial@lppeptide.com
