# Copy to .env.local (dev) or .env (server). Never commit real values.

DATABASE_PATH=./data/lppeptide.db
UPLOAD_DIR=./uploads
SITE_URL=https://lppeptide.co

# openssl rand -base64 48  (at least 32 random bytes)
AUTH_SECRET=

# First admin, used by `npm run db:seed` only. Remove ADMIN_PASSWORD after the first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Client's own mailbox (Nodemailer)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@lppeptide.co
SMTP_PASS=
MAIL_FROM="LPPEPTIDE <info@lppeptide.co>"
STORE_INBOX=info@lppeptide.co

# v2 (docs/10). Payment proofs: private files, never under UPLOAD_DIR.
PRIVATE_DIR=./data/private

# v2 customer Google sign-in (optional; hidden until both are set). Redirect URI: {SITE_URL}/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
