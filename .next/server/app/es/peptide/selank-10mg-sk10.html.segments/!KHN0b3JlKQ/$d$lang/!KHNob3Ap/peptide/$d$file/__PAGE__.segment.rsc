3a:["$","section",null,{"className":"detail-longform","aria-label":"Product details","children":[["$","$L3e",null,{"tabs":[{"id":"overview","label":"Overview"},{"id":"research","label":"Research"},{"id":"dosing","label":"Dosing & Protocol"},{"id":"sideeffects","label":"Side Effects"},{"id":"coa","label":"COA & Testing"},{"id":"reviews","label":"Reseñas - 927"},{"id":"qa","label":"Preguntas - 0"},{"id":"about-yuanpeptide","label":"About LPPEPTIDE"}]}],[["$","article","overview",{"id":"overview","className":"content-panel","children":[false,["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"What is SK10?"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Selank is a synthetic heptapeptide based on the tuftsin sequence. Human studies have examined anxiety-related clinical measures, leu-enkephalin metabolism, EEG response patterns, and functional brain connectivity after Selank exposure. Intranasal drops or solution are the delivery methods reported in the primary human research summarized on this page."}]}],["$","p","1",{"children":["$","span",null,{"children":"The vial calculation is concentration based. Dividing 10,000 mcg by the measured final volume gives mcg per mL. Multiplying that concentration by the verified pump output gives mcg per spray"}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Research context"}],null,[["$","p","0",{"children":["$","span",null,{"children":"5 mL option: 2,000 mcg/mL and 200 mcg per verified 0.10 mL spray.\n10 mL option: 1,000 mcg/mL and 100 mcg per verified 0.10 mL spray.\nFinal-volume rule: Bring the transferred solution to an exact measured final volume."}]}]],"$undefined"]}]]}]]}],["$","article","research",{"id":"research","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Research"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"Reference literature focus"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Selank is a synthetic heptapeptide based on the tuftsin sequence. Human Selank research has primarily used the intranasal route.\nQuick reference for the intranasal Selank 10 mg calculation.\nHuman research route: Intranasal drops or solution.\nPeptide amount: 10,000 mcg total in the vial.\n5 mL option: 2,000 mcg/mL and 200 mcg per verified 0.10 mL spray.\n10 mL option: 1,000 mcg/mL and 100 mcg per verified 0.10 mL spray.\nFinal-volume rule: Bring the transferred solution to an exact measured final volume."}]}]],"$undefined"]}]]}]]}],["$","article","dosing",{"id":"dosing","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Dosing & Protocol"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"LPPeptide handling reference"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Human research route: Intranasal drops or solution.\nPeptide amount: 10,000 mcg total in the vial.\n5 mL option: 2,000 mcg/mL and 200 mcg per verified 0.10 mL spray.\n10 mL option: 1,000 mcg/mL and 100 mcg per verified 0.10 mL spray.\nFinal-volume rule: Bring the transferred solution to an exact measured final volume."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Storage"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Registered 0.15% product: Protected from light, stored at no more than 10 degrees C, and not frozen.\nOpened registered product: The manufacturer permits storage at no more than 25 degrees C for up to 15 days.\nCustom research preparation: Use formulation-specific stability and microbiological controls rather than transferring the finished-product shelf life.\nLabeling: Record preparation date, final volume, concentration, vehicle, and storage conditions."}]}]],"$undefined"]}]]}]]}],["$","article","sideeffects",{"id":"sideeffects","className":"content-panel","children":["$L3f","$L40"]}],"$L41"],"$L42","$L43",["$L44"],"$L45","$L46"]}]
