3b:["$","section",null,{"className":"detail-longform","aria-label":"Product details","children":[["$","$L3f",null,{"tabs":[{"id":"overview","label":"Overview"},{"id":"research","label":"Research"},{"id":"dosing","label":"Dosing & Protocol"},{"id":"sideeffects","label":"Side Effects"},{"id":"coa","label":"COA & Testing"},{"id":"reviews","label":"Reseñas - 373"},{"id":"qa","label":"Preguntas - 0"},{"id":"about-yuanpeptide","label":"About LPPEPTIDE"}]}],[["$","article","overview",{"id":"overview","className":"content-panel","children":[false,["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"What is ARA290?"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Ara-290 (cibinetide) is an 11–amino acid non-erythropoietic peptide derived from erythropoietin’s helix-B domain. It selectively activates the innate repair receptor (IRR), an EPOR/CD131 heterodimer, to promote anti-inflammatory and tissue-protective effects without stimulating red blood cell production. Clinical trials have demonstrated benefits for diabetic neuropathy and sarcoidosis-related small-fiber neuropathy"}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Research context"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Preclinical research demonstrates that Ara-290 can reprogram a pro-inflammatory, tissue-damaging environment into one favoring healing and regeneration. Additionally, analgesic effects have been observed through immunomodulation and direct inhibition of TRPV1 ion channels activated by capsaicin"}]}]],"$undefined"]}]]}]]}],["$","article","research",{"id":"research","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Research"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"Reference literature focus"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Ara-290 (cibinetide) binds to the innate repair receptor (IRR), a heterodimer of EPOR and CD131 (βc subunit), which is distinct from the classical erythropoietin receptor. This selective binding triggers anti-apoptotic and anti-inflammatory signaling cascades that protect tissues and promote repair without stimulating erythropoiesis."}]}]],"$undefined"]}]]}]]}],["$","article","dosing",{"id":"dosing","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Dosing & Protocol"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"LPPeptide handling reference"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Suggested daily titration approach reflecting clinical study parameters.\nStart: 2 mg daily during week 1 to assess tolerance.\nTarget: 4 mg daily from week 2 onward[3].\nFrequency: Once per day (subcutaneous).\nCycle Length: 4–8 weeks standard; may extend to 16 weeks based on individual assessment.\nTiming: Any consistent time daily; rotate injection sites."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Preparation"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Reconstituted: Refrigerate at 2–8 °C (35.6–46.4 °F); use within 28 days and do not freeze the liquid solution.\nAllow vials to reach room temperature before opening to minimize condensation; protect from light.\nDiscard if discoloration, cloudiness, or particulate matter is obser"}]}]],"$undefined"]}],["$","$4","2",{"children":[["$","h2",null,{"children":"Storage"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Lyophilized: Refrigerate at 2–8 °C (35.6–46.4 °F) for up to 2 years; freeze at −20 °C (−4 °F) for extended storage up to 3 years"}]}]],"$undefined"]}]]}]]}],["$","article","sideeffects",{"id":"sideeffects","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Side Effects"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"Safety observations"}],null,"$L40","$undefined"]}],"$L41"]}]]}],"$L42"],"$L43","$L44",["$L45"],"$L46","$L47"]}]
