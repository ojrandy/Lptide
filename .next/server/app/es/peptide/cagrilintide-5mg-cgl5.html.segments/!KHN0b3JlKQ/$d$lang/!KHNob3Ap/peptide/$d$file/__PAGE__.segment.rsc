38:["$","section",null,{"className":"glance-card","aria-labelledby":"glance-heading","children":[["$","h2",null,{"id":"glance-heading","children":"De un vistazo"}],["$","dl",null,{"children":[[["$","div","0",{"children":[["$","dt",null,{"children":"LPPeptide"}],["$","dd",null,{"children":["$","span",null,{"children":"Cagrilintide"}]}]]}],["$","div","1",{"children":[["$","dt",null,{"children":"Specification"}],["$","dd",null,{"children":["$","span",null,{"children":"5mg x 10 vials /box"}]}]]}],["$","div","2",{"children":[["$","dt",null,{"children":"Category"}],["$","dd",null,{"children":["$","span",null,{"children":"Weight Loss & Metabolic"}]}]]}],["$","div","3",{"children":[["$","dt",null,{"children":"Form"}],["$","dd",null,{"children":["$","span",null,{"children":"Lyophilized powder"}]}]]}],["$","div","4",{"children":[["$","dt",null,{"children":"Knowledge source"}],["$","dd",null,{"children":["$","span",null,{"children":"Cagrilintide (CGL5 / CGL10)"}]}]]}],["$","div","5",{"children":[["$","dt",null,{"children":"LPPEPTIDE knowledge source"}],["$","dd",null,{"children":["$","span",null,{"children":"5mg x 10 vials / 10mg x 10 vials"}]}]]}],["$","div","6",{"children":[["$","dt",null,{"children":"Research focus"}],["$","dd",null,{"children":["$","span",null,{"children":"Weight Loss & Metabolic"}]}]]}],["$","div","7",{"children":[["$","dt",null,{"children":"Reconstitution"}],["$","dd",null,{"children":["$","span",null,{"children":"LPPEPTIDE knowledge source: add 3.0 mL bacteriostatic water for about 1.67 mg/mL. Reference range is once weekly 0.6-4.5 mg with gradual 4-6 week escalation. At this concentration, 1 U is about 16.7 mcg."}]}]]}],["$","div","8",{"children":[["$","dt",null,{"children":"Storage"}],["$","dd",null,{"children":["$","span",null,{"children":"Lyophilized: -20 deg C, dry and dark with minimal moisture exposure. Reconstituted: 2-8 deg C, use within about 30 days, and avoid freeze-thaw cycles."}]}]]}]],null]}]]}]
39:["$","aside",null,{"className":"purchase-column","aria-label":"Opciones de compra","children":["$","$L3d",null,{"specification":"5mg x 10 vials /box"}]}]
3a:["$","section",null,{"className":"detail-longform","aria-label":"Product details","children":[["$","$L3e",null,{"tabs":[{"id":"overview","label":"Overview"},{"id":"dosing","label":"Dosing & Protocol"},{"id":"sideeffects","label":"Side Effects"},{"id":"research","label":"Research"},{"id":"coa","label":"COA & Testing"},{"id":"reviews","label":"Reseñas - 327"},{"id":"qa","label":"Preguntas - 0"},{"id":"about-yuanpeptide","label":"About LPPEPTIDE"}]}],[["$","article","overview",{"id":"overview","className":"content-panel","children":[false,["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"What is CGL5?"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Cagrilintide is a long‑acting acylated analogue of the pancreatic hormone amylin, designed for once‑weekly subcutaneous administration. It activates central amylin receptors to promote satiety, slow gastric emptying, and reduce food intake. In phase 2 and phase 3 trials, cagrilintide produced dose‑dependent weight loss with a predominantly gastrointestinal side‑effect profile"}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Research context"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Cagrilintide is an acylated, long‑acting analogue of amylin—a hormone co‑secreted with insulin from pancreatic beta cells[2][7]. Native amylin promotes satiation, slows gastric emptying, and inhibits postprandial glucagon secretion[8][9]. By acting on central amylin receptors (particularly in the area postrema and hindbrain), cagrilintide reduces appetite and energy intake. Lipid modifications extend its half‑life to approximately 160–195 hours, enabling once‑weekly dosing"}]}]],"$undefined"]}],["$","$4","2",{"children":[["$","h2",null,{"children":"Reference literature focus"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Cagrilintide is dosed at 600 mcg–4.5 mg weekly by subcutaneous injection in educational protocols, starting low and titrating upward. A 10 mg vial reconstituted with bacteriostatic water yields about 3.33 mg/mL. This information is for research and educational use only."}]}]],"$undefined"]}]]}]]}],["$","article","dosing",{"id":"dosing","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Dosing & Protocol"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"LPPeptide handling reference"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Reconstitute: Add 3.0 mL bacteriostatic water → ~3.33 mg/mL concentration.\nTypical weekly range: 0.6–4.5 mg once weekly (gradual titration over 4–6 weeks).\nEasy measuring: At 3.33 mg/mL, 1 unit = 0.01 mL ≈ 0.0333 mg (33.3 mcg) on a U‑100 insulin syringe.\nStorage: Lyophilized: store frozen at −20 °C (−4 °F); after reconstitution, refrigerate at 2–8 °C (35.6–46.4 °F) and use within 30 days."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Preparation"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Draw 3.0 mL bacteriostatic water with a sterile syringe.\nInject slowly down the vial wall; avoid foaming or vigorous agitation.\nGently swirl or roll until fully dissolved (do not shake).\nLabel with date and concentration; refrigerate at 2–8 °C (35.6–46.4 °F), protected from light.\nUse within 30 days of reconstitution; discard if cloudy or particulate matter appears."}]}]],"$undefined"]}],["$","$4","2",{"children":[["$","h2",null,{"children":"Storage"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Proper storage preserves peptide integrity and potency.\nLyophilized: Store at −20 °C (−4 °F) in dry, dark conditions; minimize moisture exposure.\nReconstituted: Refrigerate at 2–8 °C (35.6–46.4 °F); use within 30 days and avoid freeze–thaw cycles.\nAllow vials to reach room temperature before opening to reduce condensation uptake"}]}]],"$undefined"]}]]}]]}],"$L3f","$L40","$L41"],"$L42","$L43",["$L44"],"$L45","$L46"]}]
3b:["$","$L48",null,{}]
49:I[41519,["$5","$6","$7","$a"],"WriteReview"]
