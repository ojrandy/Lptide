3b:["$","section",null,{"className":"detail-longform","aria-label":"Product details","children":[["$","$L3f",null,{"tabs":[{"id":"overview","label":"Overview"},{"id":"research","label":"Research"},{"id":"dosing","label":"Dosing & Protocol"},{"id":"sideeffects","label":"Side Effects"},{"id":"coa","label":"COA & Testing"},{"id":"reviews","label":"Reseñas - 2,280"},{"id":"qa","label":"Preguntas - 126"},{"id":"about-lppeptide","label":"About LPPeptide"}]}],[["$","article","overview",{"id":"overview","className":"content-panel","children":[false,["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"What is CP10?"}],null,[["$","p","0",{"children":["$","span",null,{"children":"GH-axis blend profile pairing CJC-1295 without DAC and Ipamorelin. The LPPEPTIDE knowledge record describes CP10 as a fixed blend of CJC-1295 without DAC, a modified GHRH analog, with Ipamorelin, a selective growth hormone secretagogue. The source highlights GH and IGF-1 marker increases from CJC-1295 and selective GH release without ACTH or cortisol increase from Ipamorelin. CJC-1295 Without DAC + Ipamorelin 10mg is mapped to LPPeptide SKU CP10. Current storefront values use our product data: 10mg x 10 vials (CJC-1295 5mg + Ipamorelin 5mg) /box, $106.00 USD per box. LPPeptide reference specs: 10mg x 10 vials (CJC-1295 5mg + Ipamorelin 5mg)."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Research context"}],null,[["$","p","0",{"children":["$","span",null,{"children":"The LPPEPTIDE knowledge record describes CP10 as a fixed blend of CJC-1295 without DAC, a modified GHRH analog, with Ipamorelin, a selective growth hormone secretagogue. The source highlights GH and IGF-1 marker increases from CJC-1295 and selective GH release without ACTH or cortisol increase from Ipamorelin. Research usually focuses on pulsatile GH-axis signaling, GHRH receptor context, ghrelin receptor selectivity, and IGF-1 pathway markers."}]}]],"$undefined"]}],["$","$4","2",{"children":[["$","h2",null,{"children":"Commonly matched with"}],null,[["$","p","0",{"children":["$","span",null,{"children":"CP10 is commonly reviewed alongside IP10, SMO-10, CJC-1295, Ipamorelin, Sermorelin. Keep each combination tied to a defined research objective and lot record."}]}]],"$undefined"]}],["$","$4","3",{"children":[["$","h2",null,{"children":"Compliance notice"}],null,[["$","p","0",{"children":["$","span",null,{"children":"CP10 is supplied for research use only. It is not for human or veterinary use, not for consumption, and statements on this page are reference context rather than medical claims."}]}]],"$undefined"]}]]}]]}],["$","article","research",{"id":"research","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Research"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"Reference literature focus"}],null,[["$","p","0",{"children":["$","span",null,{"children":"The LPPEPTIDE knowledge record describes CP10 as a fixed blend of CJC-1295 without DAC, a modified GHRH analog, with Ipamorelin, a selective growth hormone secretagogue. The source highlights GH and IGF-1 marker increases from CJC-1295 and selective GH release without ACTH or cortisol increase from Ipamorelin. Research usually focuses on pulsatile GH-axis signaling, GHRH receptor context, ghrelin receptor selectivity, and IGF-1 pathway markers."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Study design notes"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Use the LPPeptide product knowledge record, current LPPeptide COA, and internal lab SOP to confirm identity, concentration, and endpoints before this material enters a study. The matched LPPeptide reference specification is 10mg x 10 vials (CJC-1295 5mg + Ipamorelin 5mg)."}]}]],"$undefined"]}]]}]]}],["$","article","dosing",{"id"