3e:["$","section",null,{"className":"detail-longform","aria-label":"Product details","children":[["$","$L42",null,{"tabs":[{"id":"overview","label":"Overview"},{"id":"research","label":"Research"},{"id":"dosing","label":"Dosing & Protocol"},{"id":"sideeffects","label":"Side Effects"},{"id":"coa","label":"COA & Testing"},{"id":"reviews","label":"Avaliações - 2,230"},{"id":"qa","label":"Perguntas - 142"},{"id":"about-lppeptide","label":"About LPPeptide"}]}],[["$","article","overview",{"id":"overview","className":"content-panel","children":[false,["$","div",null,{"className":"panel-body","children":[["$","$1","0",{"children":[["$","h2",null,{"children":"What is XA10?"}],null,[["$","p","0",{"children":["$","span",null,{"children":"ACTH-fragment analog profile for cognitive and neuroprotective research. The LPPEPTIDE knowledge record describes Semax as a synthetic heptapeptide related to ACTH 4-10, originally developed in Russia and reviewed for neuroprotective, cognitive, neurotrophic, cerebrovascular recovery, and optic-nerve support research. SEMAX 10mg is mapped to LPPeptide SKU XA10. Current storefront values use our product data: 10mg x 10 vials /box, $85.00 USD per box. LPPeptide reference specs: 5mg x 10 vials / 10mg x 10 vials."}]}]],"$undefined"]}],["$","$1","1",{"children":[["$","h2",null,{"children":"Research context"}],null,[["$","p","0",{"children":["$","span",null,{"children":"The LPPEPTIDE knowledge record describes Semax as a synthetic heptapeptide related to ACTH 4-10, originally developed in Russia and reviewed for neuroprotective, cognitive, neurotrophic, cerebrovascular recovery, and optic-nerve support research. Research commonly reviews neurotrophic markers, cognition endpoints, stress-response context, and ACTH-fragment pathway literature."}]}]],"$undefined"]}],["$","$1","2",{"children":[["$","h2",null,{"children":"Commonly matched with"}],null,[["$","p","0",{"children":["$","span",null,{"children":"XA10 is commonly reviewed alongside ML10, P41, WA3, BAC WATER, Selank. Keep each combination tied to a defined research objective and lot record."}]}]],"$undefined"]}],["$","$1","3",{"children":[["$","h2",null,{"children":"Compliance notice"}],null,[["$","p","0",{"children":["$","span",null,{"children":"XA10 is supplied for research use only. It is not for human or veterinary use, not for consumption, and statements on this page are reference context rather than medical claims."}]}]],"$undefined"]}]]}]]}],["$","article","research",{"id":"research","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Research"}]}],["$","div",null,{"className":"panel-body","children":[["$","$1","0",{"children":[["$","h2",null,{"children":"Reference literature focus"}],null,[["$","p","0",{"children":["$","span",null,{"children":"The LPPEPTIDE knowledge record describes Semax as a synthetic heptapeptide related to ACTH 4-10, originally developed in Russia and reviewed for neuroprotective, cognitive, neurotrophic, cerebrovascular recovery, and optic-nerve support research. Research commonly reviews neurotrophic markers, cognition endpoints, stress-response context, and ACTH-fragment pathway literature."}]}]],"$undefined"]}],["$","$1","1",{"children":[["$","h2",null,{"children":"Study design notes"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Use the LPPeptide product knowledge record, current LPPeptide COA, and internal lab SOP to confirm identity, concentration, and endpoints before this material enters a study. The matched LPPeptide reference specification is 5mg x 10 vials / 10mg x 10 vials."}]}]],"$undefined"]}]]}]]}],["$","article","dosing",{"id":"dosing","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Dosing & Protocol"}]}],["$","div",null,{"className":"panel-body","children":[["$","$1","0",{"children":[["$","h2",null,{"children":"LPPeptide handling reference"}],