3f:["$","$4","0",{"children":[["$","h2",null,{"children":"LPPeptide handling reference"}],null,[["$","p","0",{"children":["$","span",null,{"children":"1.Using a sterile syringe, withdraw 1.0 mL of bacteriostatic water."}]}],["$","p","1",{"children":["$","span",null,{"children":"2.Slowly inject the diluent along the inner wall of the vial; avoid foaming."}]}],["$","p","2",{"children":["$","span",null,{"children":"3.Gently swirl or roll the vial until completely dissolved. Do not shake."}]}],["$","p","3",{"children":["$","span",null,{"children":"4.Label the vial with the date of reconstitution and store refrigerated at 2–8°C, protected from light."}]}],["$","p","4",{"children":["$","span",null,{"children":"5.Use the reconstituted solution within 4 weeks."}]}]],"$undefined"]}]
40:["$","$4","1",{"children":[["$","h2",null,{"children":"Preparation"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Reconstitution: Add 1.0 mL of bacteriostatic water to yield a concentration of approximately 10 mg/mL.\nDosage Regimen: The typical dose range is 2–8 mg administered once weekly, with gradual titration over 8–12 weeks.\nDose Conversion: At a concentration of 10 mg/mL, 1 unit (0.01 mL) on a U-100 insulin syringe is equivalent to approximately 50 mcg."}]}]],"$undefined"]}]
