3a:["$","section",null,{"className":"detail-longform","aria-label":"Product details","children":[["$","$L3e",null,{"tabs":[{"id":"overview","label":"Overview"},{"id":"research","label":"Research"},{"id":"dosing","label":"Dosing & Protocol"},{"id":"sideeffects","label":"Side Effects"},{"id":"coa","label":"COA & Testing"},{"id":"reviews","label":"Avaliações - 89"},{"id":"qa","label":"Perguntas - 3"},{"id":"about-yuanpeptide","label":"About LPPEPTIDE"}]}],[["$","article","overview",{"id":"overview","className":"content-panel","children":[false,["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"What is RT60?"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Triple-receptor incretin agonist profile for metabolic research. The LPPEPTIDE knowledge record describes Retatrutide as an investigational GLP-1, GIP, and glucagon receptor agonist studied in obesity and type 2 diabetes models, with phase II research reporting high-dose body-weight reduction up to 24% over 48 weeks. Retatrutide 60mg is mapped to LPPeptide SKU RT60.  LPPeptide reference specs: 5mg x 10 vials / 10mg x 10 vials / 15mg x 10 vials / 20mg x 10 vials / 30mg x 10 vials / 40mg x 10 vials / 60mg x 10 vials."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Research context"}],null,[["$","p","0",{"children":["$","span",null,{"children":"The LPPEPTIDE knowledge record describes Retatrutide as an investigational GLP-1, GIP, and glucagon receptor agonist studied in obesity and type 2 diabetes models, with phase II research reporting high-dose body-weight reduction up to 24% over 48 weeks. Research typically centers on GLP-1, GIP, and glucagon receptor signaling, with endpoints such as appetite signaling, glucose handling, and energy balance models."}]}]],"$undefined"]}],["$","$4","2",{"children":[["$","h2",null,{"children":"Commonly matched with"}],null,[["$","p","0",{"children":["$","span",null,{"children":"RT60 is commonly reviewed alongside RT20, RT30, TR10, TR20, Tirzepatide. Keep each combination tied to a defined research objective and lot record."}]}]],"$undefined"]}],["$","$4","3",{"children":[["$","h2",null,{"children":"Compliance notice"}],null,[["$","p","0",{"children":["$","span",null,{"children":"RT10 is supplied for research use only. It is not for human or veterinary use, not for consumption, and statements on this page are reference context rather than medical claims."}]}]],"$undefined"]}]]}]]}],["$","article","research",{"id":"research","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Research"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"Reference literature focus"}],null,[["$","p","0",{"children":["$","span",null,{"children":"The LPPEPTIDE knowledge record describes Retatrutide as an investigational GLP-1, GIP, and glucagon receptor agonist studied in obesity and type 2 diabetes models, with phase II research reporting high-dose body-weight reduction up to 24% over 48 weeks. Research typically centers on GLP-1, GIP, and glucagon receptor signaling, with endpoints such as appetite signaling, glucose handling, and energy balance models."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Study design notes"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Use the LPPeptide product knowledge record, current LPPeptide COA, and internal lab SOP to confirm identity, concentration, and endpoints before this material enters a study. The matched LPPeptide reference specification is 5mg x 10 vials / 10mg x 10 vials / 15mg x 10 vials / 20mg x 10 vials / 30mg x 10 vials / 40mg x 10 vials / 60mg x 10 vials."}]}]],"$undefined"]}]]}]]}],["$","article","dosing",{"id":"dosing","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Dosing & Protocol"}]}],["$","div",null,{"className":"panel-body","children":["$L3f","$L40","$L41"]}]]}],"$L42","$L43"],"$L44","$L45",["$L46"],"$L47","$L48"]}]
