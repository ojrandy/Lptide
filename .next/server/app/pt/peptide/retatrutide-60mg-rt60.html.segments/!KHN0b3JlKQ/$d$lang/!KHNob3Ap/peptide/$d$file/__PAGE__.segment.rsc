38:["$","section",null,{"className":"glance-card","aria-labelledby":"glance-heading","children":[["$","h2",null,{"id":"glance-heading","children":"Visão geral"}],["$","dl",null,{"children":[[["$","div","0",{"children":[["$","dt",null,{"children":"LPPeptide"}],["$","dd",null,{"children":["$","span",null,{"children":"RT60"}]}]]}],["$","div","1",{"children":[["$","dt",null,{"children":"Specification"}],["$","dd",null,{"children":["$","span",null,{"children":"60mg x 10 vials /box"}]}]]}],["$","div","2",{"children":[["$","dt",null,{"children":"Category"}],["$","dd",null,{"children":["$","span",null,{"children":"Weight Loss & Metabolic"}]}]]}],["$","div","3",{"children":[["$","dt",null,{"children":"Form"}],["$","dd",null,{"children":["$","span",null,{"children":"Lyophilized powder"}]}]]}],["$","div","4",{"children":[["$","dt",null,{"children":"Knowledge source"}],["$","dd",null,{"children":["$","span",null,{"children":"Retatrutide (RT)"}]}]]}],["$","div","5",{"children":[["$","dt",null,{"children":"Research focus"}],["$","dd",null,{"children":["$","span",null,{"children":"Weight Loss & Metabolic"}]}]]}],["$","div","6",{"children":[["$","dt",null,{"children":"Reconstitution"}],["$","dd",null,{"children":["$","span",null,{"children":"LPPEPTIDE knowledge source: add 1.0 mL bacteriostatic water for about 10 mg/mL. Reference range is once weekly 2-8 mg with gradual 8-12 week escalation. At 5.0 mg/mL, 1 U on a U-100 syringe is about 50 mcg."}]}]]}],["$","div","7",{"children":[["$","dt",null,{"children":"Storage"}],["$","dd",null,{"children":["$","span",null,{"children":"Lyophilized powder: Store frozen at -20°C or below. Stable for up to 24 months when stored under these conditions.  After reconstitution: Store refrigerated at 2–8°C. Reconstituted solution is stable for up to 4 weeks.  Allow the vial to equilibrate to room temperature prior to opening to minimize condensation."}]}]]}]],null]}]]}]
