3b:["$","section",null,{"className":"detail-longform","aria-label":"Product details","children":[["$","$L3f",null,{"tabs":[{"id":"overview","label":"Overview"},{"id":"research","label":"Research"},{"id":"dosing","label":"Dosing & Protocol"},{"id":"sideeffects","label":"Side Effects"},{"id":"coa","label":"COA & Testing"},{"id":"reviews","label":"Avaliações - 2,352"},{"id":"qa","label":"Perguntas - 134"},{"id":"about-lppeptide","label":"About LPPeptide"}]}],[["$","article","overview",{"id":"overview","className":"content-panel","children":[false,["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"What is MS20?"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Mitochondrial-derived peptide profile for metabolic homeostasis and energy research. The LPPEPTIDE knowledge record describes MOTS-C as a 16-amino-acid mitochondrial-derived peptide encoded in the mtDNA 12S rRNA region, associated with AMPK activation, metabolic homeostasis, exercise-response signals, glucose metabolism, and energy-balance research. MOTS-C 20mg is mapped to LPPeptide SKU MS20. Current storefront values use our product data: 20mg x 10 vials /box, $111.00 USD per box. LPPeptide reference specs: 10mg x 10 vials / 15mg x 10 vials / 20mg x 10 vials / 40mg x 10 vials."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Research context"}],null,[["$","p","0",{"children":["$","span",null,{"children":"The LPPEPTIDE knowledge record describes MOTS-C as a 16-amino-acid mitochondrial-derived peptide encoded in the mtDNA 12S rRNA region, associated with AMPK activation, metabolic homeostasis, exercise-response signals, glucose metabolism, and energy-balance research. Research commonly reviews AMPK pathway context, exercise-mimetic models, mitochondrial stress response, and glucose handling endpoints."}]}]],"$undefined"]}],["$","$4","2",{"children":[["$","h2",null,{"children":"Commonly matched with"}],null,[["$","p","0",{"children":["$","span",null,{"children":"MS20 is commonly reviewed alongside 2s10, ET10, NJ500, NJ1000, NAD+. Keep each combination tied to a defined research objective and lot record."}]}]],"$undefined"]}],["$","$4","3",{"children":[["$","h2",null,{"children":"Compliance notice"}],null,[["$","p","0",{"children":["$","span",null,{"children":"MS20 is supplied for research use only. It is not for human or veterinary use, not for consumption, and statements on this page are reference context rather than medical claims."}]}]],"$undefined"]}]]}]]}],["$","article","research",{"id":"research","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Research"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"Reference literature focus"}],null,[["$","p","0",{"children":["$","span",null,{"children":"The LPPEPTIDE knowledge record describes MOTS-C as a 16-amino-acid mitochondrial-derived peptide encoded in the mtDNA 12S rRNA region, associated with AMPK activation, metabolic homeostasis, exercise-response signals, glucose metabolism, and energy-balance research. Research commonly reviews AMPK pathway context, exercise-mimetic models, mitochondrial stress response, and glucose handling endpoints."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Study design notes"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Use the LPPeptide product knowledge record, current LPPeptide COA, and internal lab SOP to confirm identity, concentration, and endpoints before this material enters a study. The matched LPPeptide reference specification is 10mg x 10 vials / 15mg x 10 vials / 20mg x 10 vials / 40mg x 10 vials."}]}]],"$undefined"]}]]}]]}],["$","article","dosing",{"id":"dosing","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Dosing & P