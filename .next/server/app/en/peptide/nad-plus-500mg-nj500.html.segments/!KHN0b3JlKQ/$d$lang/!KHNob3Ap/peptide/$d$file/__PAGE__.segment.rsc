3b:["$","section",null,{"className":"detail-longform","aria-label":"Product details","children":[["$","$L3f",null,{"tabs":[{"id":"overview","label":"Overview"},{"id":"research","label":"Research"},{"id":"dosing","label":"Dosing & Protocol"},{"id":"sideeffects","label":"Side Effects"},{"id":"coa","label":"COA & Testing"},{"id":"reviews","label":"Reviews - 3,232"},{"id":"qa","label":"Q&A - 149"},{"id":"about-lppeptide","label":"About LPPeptide"}]}],[["$","article","overview",{"id":"overview","className":"content-panel","children":[false,["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"What is NJ500?"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Cellular coenzyme profile for DNA repair, mitochondrial, and energy-metabolism research. The LPPEPTIDE knowledge record describes NAD+ as a key coenzyme involved in cellular energy metabolism, DNA repair, mitochondrial function, ATP synthesis context, and sirtuin-pathway research. NAD+ 500mg is mapped to LPPeptide SKU NJ500. Current storefront values use our product data: 500mg x 10 vials /box, $59.00 USD per box. LPPeptide reference specs: 100mg x 10 vials / 500mg x 10 vials / 1000mg x 10 vials."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Research context"}],null,[["$","p","0",{"children":["$","span",null,{"children":"The LPPEPTIDE knowledge record describes NAD+ as a key coenzyme involved in cellular energy metabolism, DNA repair, mitochondrial function, ATP synthesis context, and sirtuin-pathway research. Research commonly centers on NAD+/NADH balance, sirtuin pathway context, DNA repair models, and cellular energy markers."}]}]],"$undefined"]}],["$","$4","2",{"children":[["$","h2",null,{"children":"Commonly matched with"}],null,[["$","p","0",{"children":["$","span",null,{"children":"NJ500 is commonly reviewed alongside 2s10, ET10, NJ1000, MS10, SS-31. Keep each combination tied to a defined research objective and lot record."}]}]],"$undefined"]}],["$","$4","3",{"children":[["$","h2",null,{"children":"Compliance notice"}],null,[["$","p","0",{"children":["$","span",null,{"children":"NJ500 is supplied for research use only. It is not for human or veterinary use, not for consumption, and statements on this page are reference context rather than medical claims."}]}]],"$undefined"]}]]}]]}],["$","article","research",{"id":"research","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Research"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"Reference literature focus"}],null,[["$","p","0",{"children":["$","span",null,{"children":"The LPPEPTIDE knowledge record describes NAD+ as a key coenzyme involved in cellular energy metabolism, DNA repair, mitochondrial function, ATP synthesis context, and sirtuin-pathway research. Research commonly centers on NAD+/NADH balance, sirtuin pathway context, DNA repair models, and cellular energy markers."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Study design notes"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Use the LPPeptide product knowledge record, current LPPeptide COA, and internal lab SOP to confirm identity, concentration, and endpoints before this material enters a study. The matched LPPeptide reference specification is 100mg x 10 vials / 500mg x 10 vials / 1000mg x 10 vials."}]}]],"$undefined"]}]]}]]}],["$","article","dosing",{"id":"dosing","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Dosing & Protocol"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"LPPeptide handling reference"}],null,[["$","p","0",{"children":["$","span",null,{"children":"LPPEPTIDE knowledge source: add 3.0 mL bacteriostatic water for 166