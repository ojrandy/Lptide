3e:["$","$4","1",{"children":[["$","h2",null,{"children":"Important Notes"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Practical considerations for consistency and safety.\nUse new sterile insulin syringes for each administration; dispose in a sharps container immediately after use.\nRotate injection sites systematically (abdomen, thighs, upper arms) at least 1–2 inches apart to reduce local irritation and prevent lipohypertrophy[8].\nInject slowly; wait a few seconds before withdrawing the needle to prevent solution backflow.\nDocument daily dose, injection site, and any observations to maintain consistency and track tolerability.\nIf injection‑site reactions (redness, mild swelling) occur, apply a cool compress and monitor; persistent reactions warrant protocol review."}]}]],"$undefined"]}]
3f:["$","article","dosing",{"id":"dosing","className":"content-panel","children":[["$","div",null,{"className":"section-title","children":["$","span",null,{"children":"Dosing & Protocol"}]}],["$","div",null,{"className":"panel-body","children":[["$","$4","0",{"children":[["$","h2",null,{"children":"LPPeptide handling reference"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Start: 200 mcg daily; increase by ~100 mcg weekly as tolerated[4][5].\nTarget: 400–500 mcg daily by Weeks 4–8 for maintenance anti‑inflammatory effects.\nFrequency: Once per day (subcutaneous).\nCycle Length: 8–12 weeks; optional extension to 16 weeks under monitoring.\nTiming: Any consistent time; rotate injection sites systematically."}]}]],"$undefined"]}],["$","$4","1",{"children":[["$","h2",null,{"children":"Preparation"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Lyophilized: Store at −20 °C (−4 °F) or below in dry, dark conditions; protect from moisture and light[6][7].\nReconstituted: Refrigerate at 2–8 °C (35.6–46.4 °F); use within approximately 30 days[7].\nAllow vials to reach room temperature before opening to minimize condensation uptake.\nAvoid freeze–thaw cycles: Do not refreeze reconstituted peptide solutions; prepare aliquots if long‑term storage is needed"}]}]],"$undefined"]}],["$","$4","2",{"children":[["$","h2",null,{"children":"Storage"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Reconstitution: 3.0 mL per 10 mg vial (~3.33 mg/mL) for accurate unit measurements.\nStorage: Lyophilized frozen at −20 °C (−4 °F) or below; reconstituted refrigerated at 2–8 °C (35.6–46.4 °F); avoid repeated freeze–thaw."}]}]],"$undefined"]}]]}]]}]
