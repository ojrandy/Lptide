44:["$","$1","1",{"children":[["$","h2",null,{"children":"Preparation"}],null,[["$","p","0",{"children":["$","span",null,{"children":"AOD 9604 5mg ships as Lyophilized powder. Reconstitution note: LPPEPTIDE knowledge source: add 3.0 mL sterile water for about 0.667 mg/mL. Reference range is once daily 300-500 mcg. At this concentration, 1 U is about 6.67 mcg.. Record the final concentration and preparation date in the study log."}]}]],"$undefined"]}]
45:["$","$1","2",{"children":[["$","h2",null,{"children":"Storage"}],null,[["$","p","0",{"children":["$","span",null,{"children":"Lyophilized: -20 deg C, dry and dark, with year-plus stability when protected. Reconstituted: 2-8 deg C, use within about 3-4 weeks, and avoid freezing.. Follow the most current lot-specific handling record whenever it is available."}]}]],"$undefined"]}]
