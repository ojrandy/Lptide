n":"10mg*10vials","packageSize":"10mg*10vials","amountMg":0,"categoryId":6,"tags":["Performance"],"rating":5,"reviewCount":274,"coaUrl":null,"sort":26101,"image":"/uploads/products/18205f5ed2424856944b4b8f1d302729.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":7200,"listCents":9000,"inStock":true,"stockQty":null},{"warehouseCode":"USFC","priceCents":8640,"listCents":10800,"inStock":false,"stockQty":null}]},{"id":26061,"slug":"cagrilintide-5mg-cgl5","name":"Cagrilintide 5mg","shortName":"CGL5","subtitle":"5mg x 10 vials","description":"Cagrilintide is a long‑acting acylated analogue of the pancreatic hormone amylin, designed for once‑weekly subcutaneous administration. ","sku":"CGL5","specification":"5mg x 10 vials","packageSize":"10 vials / box","amountMg":0,"categoryId":3,"tags":["Weight Loss","Metabolic"],"rating":5,"reviewCount":327,"coaUrl":null,"sort":26102,"image":"/uploads/products/d16c65b614024c54bedb2c4f72bd6d31.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":8000,"listCents":10000,"inStock":true,"stockQty":null},{"warehouseCode":"USFC","priceCents":9600,"listCents":12000,"inStock":false,"stockQty":null}]},{"id":26062,"slug":"3ml-pen-cartridge-vial-sterilized","name":"Pen Cartridge/Vial-STERILIZED","shortName":"PCV3-S","subtitle":"3ml x 10 pack","description":"10 3ml cartridges steam sterilized Individually wrapped for V1 pens, V2 pens, Gansulin, and other peptide research pen.  For research purposes only","sku":"PCV3-S","specification":"3ml x 10 pack","packageSize":"10 pack /box","amountMg":0,"categoryId":7,"tags":["Accessories"],"rating":0,"reviewCount":106,"coaUrl":null,"sort":26103,"image":"/uploads/products/2a91358fa04c4bae8a8bc7cffcae9405.png","updatedAt":1795288764000,"prices":[{"warehouseCode":"USFC","priceCents":1440,"listCents":1800,"inStock":true,"stockQty":null},{"warehouseCode":"AUSFC","priceCents":1440,"listCents":1800,"inStock":true,"stockQty":null}]},{"id":26063,"slug":"reusable-research-v2-pep-pen","name":"Reusable Research V2 Pep Pen","shortName":"RRP2","subtitle":"1 stick","description":"This reusable peptide research pen is designed to support laboratory and research workflows by reducing the need for traditional syringes.","sku":"RRP2","specification":"1 stick","packageSize":"1 stick","amountMg":0,"categoryId":7,"tags":["Accessories"],"rating":0,"reviewCount":117,"coaUrl":null,"sort":26104,"image":"/uploads/products/ad3d7d16b7ed4a58987ac3c1b266f11e.png","updatedAt":1795288764000,"prices":[{"warehouseCode":"USFC","priceCents":2880,"listCents":3600,"inStock":true,"stockQty":null},{"warehouseCode":"AUSFC","priceCents":2880,"listCents":3600,"inStock":true,"stockQty":null}]},{"id":26058,"slug":"vaginal-probiotics-vp-1","name":"Vaginal Probiotics 1","shortName":"VP-1","subtitle":"1vials*10vials","description":"Premium Vaginal Probiotics Formula for Feminine Balance – Specially formulated with targeted beneficial lactic acid bacteria to support healthy vaginal microflora, effectively maintain optimal intimate pH levels, and improve unbalanced private odor caused by daily fatigue, lifestyle changes and intimate activities. It provides all-round daily intimate care and keeps feminine private areas fresh and balanced all day long.","sku":"VP-1","specification":"1vials*10vials","packageSize":"1vials*10vials","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":0,"reviewCount":194,"coaUrl":null,"sort":26107,"image":"/uploads/products/85d3d666a5bf4b5d9117b8be912f4694.png","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":false,"stockQty":null},{"warehouseCode":"USFC","priceCents":3360,"listCents":4200,"inStock":true,"stockQty":null}]},{"id":26067,"slug":"vaginal-probiotics-vp-2","name":"VP-2 White Rose","shortName":"VP-2","subtitle":"1vials*10vials","description":"White Rose · Pure & Sweet, Gentle White Floral\nScent Description: A pure white rose fragrance—delicately sweet and elegant, without any heavy or cloying sweetness. Like white roses kissed by morning dew, fresh and soft, naturally neutralizing unwanted odors.\nScent Message: The pure floral scent of morning white roses—elegant and gentle. Intimate care that lets you be your own self, carrying a soft white floral fragrance wherever you go.","sku":"VP-2","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":0,"reviewCount":12,"coaUrl":null,"sort":26108,"image":"/uploads/products/1a85b281d1bb4783a4614e5dfd9d9fe6.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26068,"slug":"vaginal-probiotics-vp-3","name":"VP-3 Fig & Milk Sandalwood","shortName":"VP-3","subtitle":"1vials*10vials","description":"Fig Milk Sandalwood · Creamy Fruity + Warm Sandalwood, Healing & Gentle\nScent Description: Soft, creamy fig milk paired with warm sandalwood. The milky sweetness is gentle and comforting—a warm-toned fragrance that is tender and mellow.\nScent Message: The healing warmth of fig and milk sandalwood—soft, creamy, and soothing. A moment of intimate care, immersed in a healing and gentle aroma.","sku":"VP-3","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":26,"coaUrl":null,"sort":26109,"image":"/uploads/products/ea60095921d243ddb0a71aab7acf45f1.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26069,"slug":"vaginal-probiotics-vp-4","name":"VP-4 Ylang-Ylang","shortName":"VP-4","subtitle":"1vials*10vials","description":"Ylang-Ylang · Gentle & Lazy, Soft and Ambient\nScent Description: A rich yet soft ylang-ylang fragrance—warm and non-irritating. A delicate floral note that brings a gentle, relaxed feeling, neutralizing odors while providing soothing care.\nScent Message: Gentle ylang-ylang for immersive intimate care. Bring a soothing floral note into your intimate care routine—soft nourishment with a subtle fragrance that follows you.","sku":"VP-4","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":13,"coaUrl":null,"sort":26110,"image":"/uploads/products/fead473e02ef4312b30153ba4d1b51e5.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26070,"slug":"vaginal-probiotics-vp-5","name":"VP-5 Peninsula Scent","shortName":"VP-5","subtitle":"1vials*10vials","description":"Peninsula Enigma · Cool Woody Floral, Serene & Refined\nScent Description: A rosemary-tinged scent reminiscent of a coastal peninsula—cool and soothing, with a hint of green botanicals. Not sweet or cloying, but a refined, understated fragrance suited for those who prefer neutral scent profiles.\nScent Message: The evening breeze and botanical notes of a peninsula—serene and unassuming. A moment of intimate care that offers a clean, cool, and sophisticated olfactory experience.","sku":"VP-5","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":21,"coaUrl":null,"sort":26111,"image":"/uploads/products/ff1e9752b6c74c049e9c110262d3d6fd.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26071,"slug":"vaginal-probiotics-vp-6","name":"VP-6 Peony & Blush Red","shortName":"VP-6","subtitle":"1vials*10vials","description":"Peony & Rouge · Rich Peony Floral, Elegant & Noble\nScent Description: A rouge peony accord—a graceful and elegant floral scent with a soft, creamy undertone. Refined and vintage-inspired, with a lingering fragrance that is sophisticated without being gaudy.\nScent Message: Rouge peony, a gentle floral note with an inherent Eastern elegance. Intimate care that harbors a subtle, graceful fragrance.","sku":"VP-6","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":0,"reviewCount":5,"coaUrl":null,"sort":26112,"image":"/uploads/products/66530d2c357141eba98f85e49d0ce8f8.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26072,"slug":"vaginal-probiotics-vp-7","name":"VP-7 Romance Bloom","shortName":"VP-7","subtitle":"1vials*10vials","description":"Enchanted Bloom · Rich Fruity Floral, Romantic Ambience\nScent Description: A romantic fruity-floral accord with rich layers and a gentle sweetness. Opulent yet not heavy, it creates a full ambient atmosphere—a top choice for those who love sweet fragrances.\nScent Message: Enchanted Bloom's rich fruity-floral scent—opulent and romantic. Intimate care is no longer a mundane routine; tuck a romantic fragrance into the details.","sku":"VP-7","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":14,"coaUrl":null,"sort":26113,"image":"/uploads/products/aa595cd7cf8f4b64baa868e82ca13b8b.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26073,"slug":"vaginal-probiotics-vp-8","name":"VP-8 Boundless Self","shortName":"VP-8","subtitle":"1vials*10vials","description":"Boundless Self · Free & Translucent Floral, Independent & Unrestrained\nScent Description: A translucent, free-spirited floral accord—clean and clear, with no sense of constraint. Fresh and lightweight, simple yet refined, highlighting an independent and relaxed character.\nScent Message: A fragrance without boundaries, free and unconstrained. A translucent, delicate scent for women who pursue simplicity and independence.","sku":"VP-8","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":9,"coaUrl":null,"sort":26114,"image":"/uploads/products/bca3df1d571e400abea798126979778d.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26074,"slug":"vaginal-probiotics-vp-9","name":"VP-9 Rose Wood","shortName":"VP-9","subtitle":"1vials*10vials","description":"Rose & Wood · Rose + Steady Woods, Cool Rose Scent\nScent Description: Rose blended with steady woody notes—soft rose plus a subtle woodiness. Sweet yet grounded, not cloying, neutral and refined, with lasting understated elegance.\nScent Message: Rose meets calm woods—soft but not sweet, a cool and sophisticated rose scent, understated with a sense of quality.","sku":"VP-9","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":23,"coaUrl":null,"sort":26115,"image":"/uploads/products/065bd190e4914bdaaed03e700f5671f1.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26075,"slug":"matcha-30g-mc30","name":"Matcha 30g","shortName":"2-matcha-g","subtitle":"30g x 1 tin","description":"Matcha Organic Ceremonial Grade Matcha Green Tea Powder – Rich, Smooth Flavor, Ideal for Straight Matcha & Lattes","sku":"MC30","specification":"30g x 1 tin","packageSize":"30g x 1 tin","amountMg":0,"categoryId":7,"tags":["Accessories","Other Peptides"],"rating":5,"reviewCount":7,"coaUrl":null,"sort":26116,"image":"/uploads/products/35cacda43156400cb3d2eea57f462080.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"USFC","priceCents":2320,"listCents":2900,"inStock":true,"stockQty":null}]},{"id":26076,"slug":"matcha-100g-mc100","name":"Matcha 100g","shortName":"matcha","subtitle":"100g x 1 pouch","description":"Matcha Classic Grade Hatsumukashi Ceremonial Uji Matcha,1.06OZ(30g) Pure Japanese First Harvest Ceremonial Grade Matcha Green Tea Powder from Uji, Japan","sku":"MC100","specification":"100g x 1 pouch","packageSize":"100g x 1 pouch","amountMg":0,"categoryId":7,"tags":["Accessories","Other Peptides"],"rating":5,"reviewCount":6,"coaUrl":null,"sort":26117,"image":"/uploads/products/46f49bd7b9f943209b5b3098b548c5ef.png","updatedAt":1795288764000,"prices":[{"warehouseCode":"USFC","priceCents":5200,"listCents":6500,"inStock":true,"stockQty":null}]},{"id":26077,"slug":"5-amino-1mq-10am","name":"5-Amino-1MQ 10mg","shortName":"10AM","subtitle":"10mg x 10 vials","description":"5-Amino-1MQ is a small molecule investigated as an inhibitor of nicotinamide N-methyltransferase (NNMT), not a peptide. Research in cultured fat cells and diet-induced obese mice measured changes in cellular metabolites and animal obesity measures. ","sku":"10AM","specification":"10mg x 10 vials","packageSize":"10 vials / box","amountMg":0,"categoryId":3,"tags":["Weight Loss","Metabolic"],"rating":4.5,"reviewCount":47,"coaUrl":null,"sort":26118,"image":"/uploads/products/3f825125089841078e08b6d7356951e7.jpg","updatedAt":1795288764000,"prices":[{"warehouseCode":"CNFC","priceCents":3840,"listCents":4800,"inStock":true,"stockQty":null}]},{"id":26078,"slug":"adamax-50mg-am50","name":"5-Amino-1MQ 50mg","shortName":"50AM","subtitle":"50mg x 10 vials","description":"5-Amino-1MQ is a small molecule investigated as an inhibitor of nicotinamide N-methyltransferase (NNMT), not a peptide. Research in cultured fat cells and diet-induced obese mice measured changes in cellular metabolites and animal obesity measures. ","sku":"50AM","specification":"50mg x 10 vials","packageSize":"10 vials / box","amountMg":0,"categoryId":3,"tags":["Weight Loss","Metabolic"],"rating":5,"reviewCount":162,"coaUrl":null,"sort":26119,"image":"/uploads/products/c311bc24457043a2a68c60