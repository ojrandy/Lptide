10:["$","div",null,{"className":"site-shell","children":["$","main",null,{"children":["$L36",["$","$12",null,{"fallback":["$","$L37",null,{"variant":"category","products":[{"id":26058,"slug":"vaginal-probiotics-vp-1","name":"Vaginal Probiotics 1","shortName":"VP-1","subtitle":"1vials*10vials","description":"Premium Vaginal Probiotics Formula for Feminine Balance – Specially formulated with targeted beneficial lactic acid bacteria to support healthy vaginal microflora, effectively maintain optimal intimate pH levels, and improve unbalanced private odor caused by daily fatigue, lifestyle changes and intimate activities. It provides all-round daily intimate care and keeps feminine private areas fresh and balanced all day long.","sku":"VP-1","specification":"1vials*10vials","packageSize":"1vials*10vials","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":0,"reviewCount":194,"coaUrl":null,"sort":26107,"image":"/uploads/products/85d3d666a5bf4b5d9117b8be912f4694.png","updatedAt":1795282940000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":false,"stockQty":null},{"warehouseCode":"USFC","priceCents":3360,"listCents":4200,"inStock":true,"stockQty":null}]},{"id":26067,"slug":"vaginal-probiotics-vp-2","name":"VP-2 White Rose","shortName":"VP-2","subtitle":"1vials*10vials","description":"White Rose · Pure & Sweet, Gentle White Floral\nScent Description: A pure white rose fragrance—delicately sweet and elegant, without any heavy or cloying sweetness. Like white roses kissed by morning dew, fresh and soft, naturally neutralizing unwanted odors.\nScent Message: The pure floral scent of morning white roses—elegant and gentle. Intimate care that lets you be your own self, carrying a soft white floral fragrance wherever you go.","sku":"VP-2","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":0,"reviewCount":12,"coaUrl":null,"sort":26108,"image":"/uploads/products/1a85b281d1bb4783a4614e5dfd9d9fe6.jpg","updatedAt":1795282940000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26068,"slug":"vaginal-probiotics-vp-3","name":"VP-3 Fig & Milk Sandalwood","shortName":"VP-3","subtitle":"1vials*10vials","description":"Fig Milk Sandalwood · Creamy Fruity + Warm Sandalwood, Healing & Gentle\nScent Description: Soft, creamy fig milk paired with warm sandalwood. The milky sweetness is gentle and comforting—a warm-toned fragrance that is tender and mellow.\nScent Message: The healing warmth of fig and milk sandalwood—soft, creamy, and soothing. A moment of intimate care, immersed in a healing and gentle aroma.","sku":"VP-3","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":26,"coaUrl":null,"sort":26109,"image":"/uploads/products/ea60095921d243ddb0a71aab7acf45f1.jpg","updatedAt":1795282940000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26069,"slug":"vaginal-probiotics-vp-4","name":"VP-4 Ylang-Ylang","shortName":"VP-4","subtitle":"1vials*10vials","description":"Ylang-Ylang · Gentle & Lazy, Soft and Ambient\nScent Description: A rich yet soft ylang-ylang fragrance—warm and non-irritating. A delicate floral note that brings a gentle, relaxed feeling, neutralizing odors while providing soothing care.\nScent Message: Gentle ylang-ylang for immersive intimate care. Bring a soothing floral note into your intimate care routine—soft nourishment with a subtle fragrance that follows you.","sku":"VP-4","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":13,"coaUrl":null,"sort":26110,"image":"/uploads/products/fead473e02ef4312b30153ba4d1b51e5.jpg","updatedAt":1795282940000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26070,"slug":"vaginal-probiotics-vp-5","name":"VP-5 Peninsula Scent","shortName":"VP-5","subtitle":"1vials*10vials","description":"Peninsula Enigma · Cool Woody Floral, Serene & Refined\nScent Description: A rosemary-tinged scent reminiscent of a coastal peninsula—cool and soothing, with a hint of green botanicals. Not sweet or cloying, but a refined, understated fragrance suited for those who prefer neutral scent profiles.\nScent Message: The evening breeze and botanical notes of a peninsula—serene and unassuming. A moment of intimate care that offers a clean, cool, and sophisticated olfactory experience.","sku":"VP-5","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":21,"coaUrl":null,"sort":26111,"image":"/uploads/products/ff1e9752b6c74c049e9c110262d3d6fd.jpg","updatedAt":1795282940000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26071,"slug":"vaginal-probiotics-vp-6","name":"VP-6 Peony & Blush Red","shortName":"VP-6","subtitle":"1vials*10vials","description":"Peony & Rouge · Rich Peony Floral, Elegant & Noble\nScent Description: A rouge peony accord—a graceful and elegant floral scent with a soft, creamy undertone. Refined and vintage-inspired, with a lingering fragrance that is sophisticated without being gaudy.\nScent Message: Rouge peony, a gentle floral note with an inherent Eastern elegance. Intimate care that harbors a subtle, graceful fragrance.","sku":"VP-6","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":0,"reviewCount":5,"coaUrl":null,"sort":26112,"image":"/uploads/products/66530d2c357141eba98f85e49d0ce8f8.jpg","updatedAt":1795282940000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26072,"slug":"vaginal-probiotics-vp-7","name":"VP-7 Romance Bloom","shortName":"VP-7","subtitle":"1vials*10vials","description":"Enchanted Bloom · Rich Fruity Floral, Romantic Ambience\nScent Description: A romantic fruity-floral accord with rich layers and a gentle sweetness. Opulent yet not heavy, it creates a full ambient atmosphere—a top choice for those who love sweet fragrances.\nScent Message: Enchanted Bloom's rich fruity-floral scent—opulent and romantic. Intimate care is no longer a mundane routine; tuck a romantic fragrance into the details.","sku":"VP-7","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":14,"coaUrl":null,"sort":26113,"image":"/uploads/products/aa595cd7cf8f4b64baa868e82ca13b8b.jpg","updatedAt":1795282940000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26073,"slug":"vaginal-probiotics-vp-8","name":"VP-8 Boundless Self","shortName":"VP-8","subtitle":"1vials*10vials","description":"Boundless Self · Free & Translucent Floral, Independent & Unrestrained\nScent Description: A translucent, free-spirited floral accord—clean and clear, with no sense of constraint. Fresh and lightweight, simple yet refined, highlighting an independent and relaxed character.\nScent Message: A fragrance without boundaries, free and unconstrained. A translucent, delicate scent for women who pursue simplicity and independence.","sku":"VP-8","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":9,"coaUrl":null,"sort":26114,"image":"/uploads/products/bca3df1d571e400abea798126979778d.jpg","updatedAt":1795282940000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]},{"id":26074,"slug":"vaginal-probiotics-vp-9","name":"VP-9 Rose Wood","shortName":"VP-9","subtitle":"1vials*10vials","description":"Rose & Wood · Rose + Steady Woods, Cool Rose Scent\nScent Description: Rose blended with steady woody notes—soft rose plus a subtle woodiness. Sweet yet grounded, not cloying, neutral and refined, with lasting understated elegance.\nScent Message: Rose meets calm woods—soft but not sweet, a cool and sophisticated rose scent, understated with a sense of quality.","sku":"VP-9","specification":"1vials*10vials","packageSize":"1vials*10vials /box","amountMg":0,"categoryId":9,"tags":["Lyophilized Balls"],"rating":5,"reviewCount":23,"coaUrl":null,"sort":26115,"image":"/uploads/products/065bd190e4914bdaaed03e700f5671f1.jpg","updatedAt":1795282940000,"prices":[{"warehouseCode":"CNFC","priceCents":2800,"listCents":3500,"inStock":true,"stockQty":null}]}],"categoryNames":{"9":"Fragrance Intimate Lyophilized Balls"},"warehouses":[{"code":"CNFC","name":"Worldwide Warehouse","tagline":"Ships to all other countries worldwide"},{"code":"USFC","name":"Us Warehouse","tagline":"Ships to USA only"},{"code":"AUSFC","name":"Aus Warehouse","tagline":"Ships to Australia only"}],"heading":"Fragrance Intimate Lyophilized Balls","summary":"{count} products","aside":"$L38"}],"children":"$L39"}],"$L3a","$L3b"]}]}]
